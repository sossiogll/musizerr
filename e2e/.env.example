# The e2e smoke suite (e2e/README.md). Copied to e2e/.env on the first run.
# A throwaway account on the LOCAL dev instance, created/reset by
# app/scripts/e2e_user.py: never a real password.
E2E_USERNAME=e2e
E2E_PASSWORD=e2e-local-dev-only-8f3kq
# A throwaway administrator, for the specs that decide a user's download request.
# Its password is not published: e2e/run.sh makes a random one the first time and
# keeps it in e2e/.env.
E2E_ADMIN_USERNAME=e2e-admin
E2E_ADMIN_PASSWORD=
# The dev frontend as the Playwright container sees it (compose network).
E2E_BASE_URL=http://frontend:5173
# docker-compose.dev.yml defaults: API container and network.
E2E_APP_CONTAINER=musizerr-app-1
E2E_NETWORK=musizerr_default
