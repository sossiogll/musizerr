# Musizerr — the variables of docker-compose.yaml. Copy this file to `.env` next to it (never commit `.env`).
# The guide, with the commands that generate each secret: docs/deployment.md.
#
# Required (no default, compose refuses to start without them): POSTGRES_PASSWORD, AUTH_SECRET, CREDENTIALS_KEY.

# --- Where Musizerr is reached from (docs/deployment.md, "The public URL") ---
# The port the web app is published on (host side). Default 80.
# APP_PORT=80

# The address your users type in the browser, with no trailing slash:
#   http://192.168.1.20:8080   https://music.example.org   http://my-server.my-tailnet.ts.net
# OAuth2 providers send the browser back to "<PUBLIC_URL>/api/auth/<provider>/callback" (the redirect URI to
# register at the service) and the sign-in ends on PUBLIC_URL, so it must be the address as the BROWSER sees it.
# Default http://localhost, which is right only on the machine that runs the stack and only on port 80 (set it when
# APP_PORT is not 80).
# PUBLIC_URL=
#
# Only when the two differ from what PUBLIC_URL gives (a proxy that does not forward /api, say):
#   APP_BASE_URL   the base of the OAuth2 callback, default "<PUBLIC_URL>/api"
#   FRONTEND_URL   where the browser is sent when a sign-in ends, default PUBLIC_URL
# APP_BASE_URL=
# FRONTEND_URL=

# Where the web app's nginx reaches the API: scheme://host:port, no path. Default http://app:8000, the `app` service of
# docker-compose.yaml; change it only if you renamed that service or run the API elsewhere. nginx looks the name up again
# every few seconds, so a recreated API container is found.
# BACKEND_URL=http://app:8000

# --- Sessioni (docs/permissions.md) ---------------------------------------
# AUTH_SECRET firma i token di sessione. È OBBLIGATORIA nei file docker-compose
# e NON va nel repository: scrivila qui, in .env. Con l'autenticazione attiva
# l'app rifiuta di partire se è vuota, più corta di 32 caratteri o un segnaposto
# (change-me-in-production, change-me, secret): chi la conosce può falsificare
# il token di un amministratore. Un valore lungo e casuale, generato così:
#   openssl rand -hex 32
# Cambiarla fa uscire tutti: ognuno dovrà accedere di nuovo.
# AUTH_SECRET=

# --- Database (docs/postgresql.md) ---------------------------------------
# I file docker-compose girano su PostgreSQL. POSTGRES_PASSWORD è obbligatoria e
# NON va nel repository: scrivila qui, in .env. Finisce dentro DATABASE_URL, quindi
# usa lettere e cifre (es. `openssl rand -hex 24`).
# POSTGRES_PASSWORD=
# POSTGRES_USER=musizerr
# POSTGRES_DB=musizerr
#
# DATABASE_URL: dove sono i dati. Compose lo costruisce dalle tre variabili qui
# sopra; fuori da compose si imposta a mano. Non impostata: SQLite, il file
# DATA_DIR/musizerr.db.
# DATABASE_URL=postgresql+psycopg://musizerr:password@postgres:5432/musizerr
#
# Quanto (ms) una scrittura aspetta il lock di un'altra prima di rispondere
# 503 database_busy (default 15000): busy timeout di SQLite, lock_timeout di
# PostgreSQL. API e worker condividono il DB.
# DB_BUSY_TIMEOUT_MS=15000
# PostgreSQL: una query oltre questo tempo (ms) viene interrotta (default
# 120000, 0 = mai).
# DB_STATEMENT_TIMEOUT_MS=120000
# PostgreSQL: connessioni per processo (API e ogni worker; default 5 + 10 di
# overflow). max_connections del server deve coprire la somma.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# --- Credenziali cifrate (docs/credentials.md) ----------------------------
# CREDENTIALS_KEY cifra tutto ciò che Musizerr conserva per collegarsi ai
# servizi: token OAuth2, login, API key, client OAuth, token delle sorgenti
# e impostazioni segrete. È OBBLIGATORIA nei file docker-compose e NON va nel
# repository: scrivila qui, in .env. L'app e i worker rifiutano di partire se
# manca, è vuota o non è una chiave valida. Una chiave Fernet (44 caratteri),
# generata UNA volta così:
#   docker run --rm musizerr-app python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# (un'immagine costruita prima di questa funzione non ha ancora la libreria, e
# compose non costruisce nulla senza la chiave: la stessa chiave si ottiene con
#   openssl rand -base64 32 | tr '+/' '-_'
# che dà la base64 urlsafe di 32 byte casuali, cioè una chiave Fernet valida.)
# CONSERVALA con i backup del database (insieme a questo .env): senza la chiave
# le credenziali salvate non si possono più leggere e ogni account va
# ricollegato. Non cambiarla a mano: per sostituirla vedi "Rotazione".
# CREDENTIALS_KEY=
#
# Rotazione: la nuova chiave diventa CREDENTIALS_KEY, la vecchia va qui (più
# chiavi separate da virgole), poi `python -m scripts.rotate_credentials_key
# --apply` ricifra tutto; infine si toglie la vecchia da questa riga.
# CREDENTIALS_KEY_PREVIOUS=

# --- Folders (docs/deployment.md, "Folders") ---------------------------------
# The folder where Musizerr and the provider gateway exchange files: the host creates a folder per call in it and the
# gateway mounts each provider's part in its sandbox. ONE variable sets both sides (the host's `workspace_dir` setting
# takes it as its default, the gateway's GATEWAY_WORKSPACE_DIR is this value). It must lie inside a volume that the app,
# the workers AND the gateway all mount at the same path; the default is inside the `downloads` volume.
# WORKSPACE_DIR=/downloads/.musizerr-work
#
# The folders a provider may be given a path inside of (a local storage provider's library, for one): ":"-separated,
# absolute, each mounted in the gateway container. Default /downloads, the `downloads` volume. To add a library folder
# of the host, mount it in the gateway (a docker-compose.override.yml) and list it here:
#   GATEWAY_FILESYSTEM_ROOTS=/downloads:/library
# GATEWAY_FILESYSTEM_ROOTS=/downloads

# --- Provider gateway (docs/gateway.md) ---------------------------------------
# The seccomp profile of the gateway container, a file on the machine that runs Docker. Default: the one in a clone of
# the repository. Installing from the files of a release, they sit side by side and this is
# ./musizerr-gateway.seccomp.json already (the release's docker-compose.yaml says so).
# GATEWAY_SECCOMP_PROFILE=./gateway/seccomp/musizerr-gateway.json
#
# The most processes and threads the gateway container may hold, the gateway and every provider's sandbox together (the
# container's pids limit: nothing outside the container counts toward it, so a busy host does not matter). Each sandbox
# is also held to the `limits.processes` of its provider's manifest (default 512, at most 1024) by the gateway.
# GATEWAY_PIDS_LIMIT=4096

# --- Libreria musicale (solo docker-compose.dev.yml) ------------------------
# La cartella della libreria che lo stack di sviluppo monta come /downloads
# (download, workspace dei provider, storage locale). Default: ./data/music.
# MUSIC_DIR=/percorso/della/musica

# --- Immagini (docker-compose.yaml) ----------------------------------------
# docker-compose.yaml usa le immagini pubblicate su GHCR (linux/amd64 e
# linux/arm64). Senza MUSIZERR_VERSION prende :latest, cioè l'ultimo merge su
# master; con una versione (i tag delle release GitHub, senza la "v") resta su
# quella finché non la cambi. Dopo averla cambiata: docker compose pull && docker compose up -d
# MUSIZERR_VERSION=1.2.0
# Un altro registry o proprietario (un fork):
# MUSIZERR_IMAGES=ghcr.io/sossiogll
# Per costruire le immagini dal sorgente invece di scaricarle:
#   docker compose -f docker-compose.yaml -f docker-compose.build.yml up -d --build
