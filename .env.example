# Porta esposta dall'app (default 8000)
APP_PORT=8000

# Redis (usato da Celery e SSE)
# REDIS_URL=redis://redis:6379/0

# URL pubblico per il callback OAuth2.
# - Locale (default): lasciare vuoto — il backend è su http://localhost:8000
# - Con dev tunnel (es. VS Code devtunnels):
#   PUBLIC_URL=https://<tunnel-id>-3000.euw.devtunnels.ms
#   Il callback passerà attraverso il proxy Vite /api/
#
# PUBLIC_URL=

# --- Sessioni (docs/permissions.md) ---------------------------------------
# AUTH_SECRET firma i token di sessione. È OBBLIGATORIA nei file docker-compose
# e NON va nel repository: scrivila qui, in .env. Con l'autenticazione attiva
# l'app rifiuta di partire se è vuota, più corta di 32 caratteri o un segnaposto
# (change-me-in-production, change-me, secret): chi la conosce può falsificare
# il token di un amministratore. Un valore lungo e casuale, generato così:
#   openssl rand -hex 32
# Cambiarla fa uscire tutti: ognuno dovrà accedere di nuovo.
# AUTH_SECRET=

# --- Database (docs/postgresql.md) ---------------------------------------
# I file docker-compose girano su PostgreSQL. POSTGRES_PASSWORD è obbligatoria e
# NON va nel repository: scrivila qui, in .env. Finisce dentro DATABASE_URL, quindi
# usa lettere e cifre (es. `openssl rand -hex 24`).
# POSTGRES_PASSWORD=
# POSTGRES_USER=musizerr
# POSTGRES_DB=musizerr
#
# DATABASE_URL: dove sono i dati. Compose lo costruisce dalle tre variabili qui
# sopra; fuori da compose si imposta a mano. Non impostata: SQLite, il file
# DATA_DIR/musizerr.db.
# DATABASE_URL=postgresql+psycopg://musizerr:password@postgres:5432/musizerr
#
# Quanto (ms) una scrittura aspetta il lock di un'altra prima di rispondere
# 503 database_busy (default 15000): busy timeout di SQLite, lock_timeout di
# PostgreSQL. API e worker condividono il DB.
# DB_BUSY_TIMEOUT_MS=15000
# PostgreSQL: una query oltre questo tempo (ms) viene interrotta (default
# 120000, 0 = mai).
# DB_STATEMENT_TIMEOUT_MS=120000
# PostgreSQL: connessioni per processo (API e ogni worker; default 5 + 10 di
# overflow). max_connections del server deve coprire la somma.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# --- Credenziali cifrate (docs/credentials.md) ----------------------------
# CREDENTIALS_KEY cifra tutto ciò che Musizerr conserva per collegarsi ai
# servizi: token OAuth2, login, API key, client OAuth, token delle sorgenti
# e impostazioni segrete. È OBBLIGATORIA nei file docker-compose e NON va nel
# repository: scrivila qui, in .env. L'app e i worker rifiutano di partire se
# manca, è vuota o non è una chiave valida. Una chiave Fernet (44 caratteri),
# generata UNA volta così:
#   docker run --rm musizerr-app python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# (un'immagine costruita prima di questa funzione non ha ancora la libreria, e
# compose non costruisce nulla senza la chiave: la stessa chiave si ottiene con
#   openssl rand -base64 32 | tr '+/' '-_'
# che dà la base64 urlsafe di 32 byte casuali, cioè una chiave Fernet valida.)
# CONSERVALA con i backup del database (insieme a questo .env): senza la chiave
# le credenziali salvate non si possono più leggere e ogni account va
# ricollegato. Non cambiarla a mano: per sostituirla vedi "Rotazione".
# CREDENTIALS_KEY=
#
# Rotazione: la nuova chiave diventa CREDENTIALS_KEY, la vecchia va qui (più
# chiavi separate da virgole), poi `python -m scripts.rotate_credentials_key
# --apply` ricifra tutto; infine si toglie la vecchia da questa riga.
# CREDENTIALS_KEY_PREVIOUS=

# --- Libreria musicale (solo docker-compose.dev.yml) ------------------------
# La cartella della libreria che lo stack di sviluppo monta come /downloads
# (download, workspace dei provider, storage locale). Default: ./data/music.
# MUSIC_DIR=/percorso/della/musica
