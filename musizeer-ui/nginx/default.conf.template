# The web app's nginx. The official image renders this file at every start (envsubst, the output is
# /etc/nginx/conf.d/default.conf) and replaces ONLY the variables NGINX_ENVSUBST_FILTER names (see the
# Dockerfile): MUSIZEER_BACKEND_URL and MUSIZEER_DNS_RESOLVER. Every other $name here is nginx's own and is left alone.
#
#   MUSIZEER_BACKEND_URL   where the API is, scheme://host:port with no path (default http://app:8000: the `app` service
#                 of docker-compose.yaml). Checked at start by 15-backend-url.envsh.
#   MUSIZEER_DNS_RESOLVER  the name server nginx asks for the backend's address (default 127.0.0.11, Docker's own).
#
# The backend is reached through a VARIABLE (`set $backend`), which makes nginx resolve its name at run time,
# every `valid` seconds, instead of once at start: an `app` container that was recreated (a new address) is found
# again, and a stack that starts the frontend before the API does not make nginx refuse to start.

# The scheme and host the browser used, for the API. A proxy in front of this one (TLS termination) sends them;
# a request that comes straight in gets this server's own. A scheme other than http/https is not passed on.
map $http_x_forwarded_proto $forwarded_proto {
    default  $scheme;
    "http"   "http";
    "https"  "https";
}

map $http_x_forwarded_host $forwarded_host {
    default  $http_x_forwarded_host;
    ""       $http_host;
}

server {
    listen 80;
    server_name _;

    resolver ${MUSIZEER_DNS_RESOLVER} valid=10s ipv6=off;
    resolver_timeout 5s;

    set $backend "${MUSIZEER_BACKEND_URL}";

    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }

    # /api/<path> is the API's /<path>: the prefix is dropped (a variable in proxy_pass takes no URI of its own,
    # so the rewrite does it; the query string stays).
    location /api/ {
        rewrite            ^/api/(.*)$ /$1 break;
        proxy_pass         $backend;
        proxy_ssl_server_name on;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $forwarded_proto;
        proxy_set_header   X-Forwarded-Host $forwarded_host;
        proxy_read_timeout 60s;
    }

    # The progress stream (server-sent events): no buffering, no cache, an hour of silence allowed.
    location /api/progress {
        rewrite                ^/api/(.*)$ /$1 break;
        proxy_pass             $backend;
        proxy_ssl_server_name  on;
        proxy_set_header       Host $host;
        proxy_set_header       X-Forwarded-Proto $forwarded_proto;
        proxy_set_header       X-Forwarded-Host $forwarded_host;
        proxy_set_header       Connection '';
        proxy_http_version     1.1;
        proxy_buffering        off;
        proxy_cache            off;
        proxy_read_timeout     3600s;
        chunked_transfer_encoding on;
    }
}
